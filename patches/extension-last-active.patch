++  // Magnetite: update the list managed by `BrowserList` synchronously, on
++  // every platform, and move this browser to its front even if it counts as
++  // active already. An explicit Activate() (DevTools Target.activateTarget,
++  // chrome.windows.update with focused) makes it the browser activated last,
++  // which tabs.query({lastFocusedWindow}) and windows.getLastFocused report,
++  // also where the system never activates a child window by itself (Linux).
++  auto* active_state = BrowserActiveStateManager::From(browser_);
++  if (active_state->IsActive()) {
++    active_state->DidBecomeInactive();
++  }
++  active_state->DidBecomeActive();
+   browser_widget_->Activate();
+ }
