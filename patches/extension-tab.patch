+// static
+std::optional<content::WebContents*> BrowserDelegate::OpenExtensionTab(
+    BrowserWindowInterface* opener,
+    const GURL& url,
+    bool active,
+    int index,
+    bool pinned) {
+  return ChromeBrowserDelegate::OpenExtensionTab(opener, url, active, index,
+                                                 pinned);
+}
+
+// static
+void BrowserDelegate::ExtensionPinnedTab(content::WebContents* contents,
+                                         bool pinned) {
+  ChromeBrowserDelegate::ExtensionPinnedTab(contents, pinned);
+}
