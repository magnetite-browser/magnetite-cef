+// static
+std::optional<content::WebContents*> ChromeBrowserDelegate::OpenExtensionTab(
+    BrowserWindowInterface* opener,
+    const GURL& url,
+    bool active) {
+  // Magnetite: a Views-hosted browser has no tab strip, so Chromium would put
+  // the tab an extension asks for in a Chrome window of its own. An
+  // application that hosts its pages in its own views then has to load the
+  // address again in a browser it made itself, and the tab the extension got
+  // back (its id, its events) is not the one the user sees. Here the tab
+  // becomes a Views-hosted popup of |opener| instead: the application gets
+  // its BrowserView in CefBrowserViewDelegate::OnPopupBrowserViewCreated and
+  // the extension's tab is the page on screen.
+  //
+  // The client is asked first, with CefLifeSpanHandler::OnBeforePopup:
+  // |popup_id| is kExtensionTabPopupId, which no popup of a page has, |frame|
+  // is the opener's main frame and the disposition says whether the tab is to
+  // be in front. Returning true leaves the tab to Chromium's default, as
+  // does every other way out of here that returns no value.
+  static constexpr int kExtensionTabPopupId = -1;
+
+  CefRefPtr<CefBrowserHostBase> opener_browser_host =
+      opener ? ChromeBrowserHostImpl::GetBrowserForBrowser(opener) : nullptr;
+  if (!opener_browser_host ||
+      !CefBrowserInfoManager::ShouldCreateViewsHostedPopup(
+          opener_browser_host, /*use_default_browser_creation=*/false)) {
+    return std::nullopt;
+  }
+
+  // Popups share the request context of their opener.
+  Profile* profile = opener->GetProfile();
+  if (CefRequestContextImpl::GetProfile(
+          opener_browser_host->request_context()) != profile) {
+    return std::nullopt;
+  }
+
+  CefBrowserCreateParams create_params;
+  create_params.client = opener_browser_host->GetClient();
+  create_params.settings = opener_browser_host->settings();
+  create_params.extra_info = opener_browser_host->browser_info()->extra_info();
+
+  auto life_span_handler = create_params.client
+                               ? create_params.client->GetLifeSpanHandler()
+                               : nullptr;
+  if (!life_span_handler) {
+    return std::nullopt;
+  }
+
+  CefWindowInfo window_info;
+  CefBrowserCreateParams::InitWindowInfo(&window_info,
+                                         opener_browser_host.get());
+
+  // The client's callback may close the opener.
+  base::WeakPtr<BrowserWindowInterface> weak_opener = opener->GetWeakPtr();
+
+  CefPopupFeatures popup_features;
+  bool no_javascript_access = false;
+  if (life_span_handler->OnBeforePopup(
+          opener_browser_host.get(), opener_browser_host->GetMainFrame(),
+          kExtensionTabPopupId, url.spec(), CefString(),
+          active ? CEF_WOD_NEW_FOREGROUND_TAB : CEF_WOD_NEW_BACKGROUND_TAB,
+          /*user_gesture=*/false, popup_features, window_info,
+          create_params.client, create_params.settings,
+          create_params.extra_info, &no_javascript_access) ||
+      !weak_opener) {
+    return std::nullopt;
+  }
+
+  create_params.popup_with_views_hosted_opener = true;
+  create_params.popup_with_alloy_style_opener = false;
+
+  auto platform_delegate = CefBrowserPlatformDelegate::Create(create_params);
+  CHECK(platform_delegate);
+
+  // Expect runtime style to match.
+  CHECK(platform_delegate->IsChromeStyle());
+
+  // As CreateTargetContents does for a new tab (browser_navigator.cc).
+  content::WebContents::CreateParams contents_params(
+      profile, tab_util::GetSiteInstanceForNewTab(profile, url));
+  contents_params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(contents_params);
+  content::WebContents* new_contents = contents.get();
+  // The client's callbacks below may close the tab.
+  base::WeakPtr<content::WebContents> weak_contents = contents->GetWeakPtr();
+
+  // Create the browser host. Results in the calls to
+  // CefBrowserViewDelegate::OnPopupBrowserViewCreated and
+  // CefLifeSpanHandler::OnAfterCreated.
+  auto browser_host = CreateBrowserHostForPopup(
+      new_contents, create_params.settings, create_params.client,
+      create_params.extra_info, std::move(platform_delegate),
+      /*is_devtools_popup=*/false, opener_browser_host);
+
+  // Create a new Browser and give it ownership of the new WebContents.
+  browser_host->AddNewContents(std::move(contents), std::nullopt);
+
+  if (!weak_contents) {
+    // Closed by the client meanwhile: the tab was opened and is gone, and
+    // Chromium is not to open another one.
+    return std::optional<content::WebContents*>(nullptr);
+  }
+
+  content::NavigationController::LoadURLParams load_params(url);
+  load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  new_contents->GetController().LoadURLWithParams(load_params);
+
+  return new_contents;
+}
