   void GetWindowMask(const gfx::Size& size, SkPath* window_mask) override {
-    // Nothing to do here.
+#if BUILDFLAG(IS_LINUX)
+    // Magnetite: a Window with round corners (CefWindowImpl::SetThemeColor)
+    // shows its parent outside them only if it is translucent. An X11 window
+    // is not without a compositing manager and would show its background
+    // there, so X11 cuts it to this mask instead (without anti-aliasing).
+    // X11 only: on Wayland the mask would clip what the window paints, and
+    // ShouldWindowContentsBeTransparent would ask for it again.
+    if (ui::OzonePlatform::GetPlatformNameForTest() == "wayland" ||
+        widget_->ShouldWindowContentsBeTransparent()) {
+      return;
+    }
+    const ui::Layer* layer = widget_->GetLayer();
+    const float radius = layer ? layer->rounded_corner_radii().upper_left() : 0;
+    const SkRect bounds = SkRect::MakeWH(size.width(), size.height());
+    if (radius > 0) {
+      *window_mask = SkPath::RRect(bounds, radius, radius);
+      shaped_ = true;
+    } else if (shaped_) {
+      // Given no mask, X11 keeps the window's last shape.
+      *window_mask = SkPath::Rect(bounds);
+    }
+#endif
   }
 
