 void CefWindowImpl::SetThemeColor(int color_id, cef_color_t color) {
   CEF_REQUIRE_VALID_RETURN_VOID();
+#if BUILDFLAG(IS_LINUX)
+  if (color_id == kCornerRadiusId) {
+    // Rounds everything the Window shows, the page's own layers included.
+    // Outside the corners a Window with a parent shows that parent
+    // (CefWindowView::CreateWidget makes it translucent).
+    if (widget_ && widget_->GetLayer()) {
+      ui::Layer* layer = widget_->GetLayer();
+      layer->SetRoundedCornerRadius(
+          gfx::RoundedCornersF(static_cast<float>(color)));
+      layer->SetIsFastRoundedCorner(color != 0);
+      // An X11 window without a compositing manager cannot be translucent
+      // and is cut to its corners instead (CaptionlessFrameView::
+      // GetWindowMask). Setting no shape makes X11 ask for that mask again.
+      if (!IsRunningOnWayland()) {
+        widget_->SetShape(nullptr);
+      }
+    }
+    return;
+  }
+#endif
   if (root_view()) {
     view_util::SetColor(root_view(), color_id, color);
   }
