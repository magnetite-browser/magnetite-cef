+// Magnetite: the message a client sends to the browser process on a frame of
+// a browser (`CefFrame::SendProcessMessage` with `PID_BROWSER`, which CEF
+// does not take otherwise) to share that browser's tab in place of the tab a
+// page shares now. It has no arguments.
+constexpr char kShareTabInsteadMessage[] = "magnetite.share-tab-instead";
+
+// Share `web_contents` in place of the tab a page shares now, as the "Share
+// this tab instead" button of Chrome's tab-sharing infobar on it does. While
+// a page shares a tab, Chrome puts that infobar on every tab of the page's
+// profile, with the button only where switching is possible and allowed:
+// not on the shared tab, not on the capturing tab unless the page asked for
+// its own tab, nowhere if the page asked for no switching. Without such a
+// button nothing happens.
+void ShareTabInstead(content::WebContents* web_contents) {
+  auto* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents);
+  if (!manager) {
+    return;
+  }
+  constexpr auto kButton = TabSharingInfoBarDelegate::kShareThisTabInstead;
+  for (infobars::InfoBar* infobar : manager->infobars()) {
+    if (infobar->delegate()->GetIdentifier() !=
+        infobars::InfoBarDelegate::TAB_SHARING_INFOBAR_DELEGATE) {
+      continue;
+    }
+    auto* sharing =
+        static_cast<TabSharingInfoBarDelegate*>(infobar->delegate());
+    if ((sharing->GetButtons() & kButton) &&
+        sharing->IsButtonEnabled(kButton)) {
+      // The switch replaces the infobars: none is touched after this.
+      sharing->ShareThisTabInstead();
+      return;
+    }
+  }
+}
+
