+// Magnetite: the message a client sends to the browser process on a frame of
+// a browser (`CefFrame::SendProcessMessage` with `PID_BROWSER`) to say
+// whether the browser's tab is pinned, with one bool argument. An
+// application that keeps pinned tabs of its own tells Chromium so, and to
+// extensions the tab is pinned or not as it is in the application.
+constexpr char kSetTabPinnedMessage[] = "magnetite.set-tab-pinned";
+
+void SetTabPinned(content::WebContents* web_contents, bool pinned) {
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabListInterface* tab_list =
+      window ? TabListInterface::From(window) : nullptr;
+  if (!tab_list || tab->IsPinned() == pinned) {
+    return;
+  }
+  if (pinned) {
+    tab_list->PinTab(tab->GetHandle());
+  } else {
+    tab_list->UnpinTab(tab->GetHandle());
+  }
+}
+
 }  // namespace
 
