+ #if BUILDFLAG(IS_MAC)
++namespace {
++
++// The keychain access group the Touch ID authenticator keeps its credentials
++// in. Chromium names it at build time, from its own team and bundle
++// identifier; an app that embeds this framework is signed with its own, and
++// can only be entitled to a group that begins with them. So the group is the
++// running app's application identifier (the entitlement its signature
++// carries, "<team>.<bundle identifier>") with ".webauthn". An app signed
++// without that entitlement gets Chromium's group as before, and with it no
++// Touch ID authenticator.
++std::string TouchIdKeychainAccessGroup() {
++  base::apple::ScopedCFTypeRef<SecTaskRef> task(SecTaskCreateFromSelf(nullptr));
++  if (task) {
++    base::apple::ScopedCFTypeRef<CFTypeRef> value(
++        SecTaskCopyValueForEntitlement(
++            task.get(), CFSTR("com.apple.application-identifier"), nullptr));
++    CFStringRef identifier = base::apple::CFCast<CFStringRef>(value.get());
++    if (identifier && CFStringGetLength(identifier) > 0) {
++      return base::SysCFStringRefToUTF8(identifier) + ".webauthn";
++    }
++  }
++  return MAC_TEAM_IDENTIFIER_STRING "." MAC_BUNDLE_IDENTIFIER_STRING ".webauthn";
++}
++
++}  // namespace
++
